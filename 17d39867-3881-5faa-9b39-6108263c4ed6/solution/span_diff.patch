+        ],
+        any_order=True,
+    )
+    lockfile_spy.assert_has_calls(
+        [
+            mocker.call(test1_stage.dvcfile._lockfile, [test1_stage, test2_stage]),
+            mocker.call(test3_stage.dvcfile._lockfile, [test3_stage]),
+        ],
+        any_order=True,
+    )
+    assert dvc.status() == {}
