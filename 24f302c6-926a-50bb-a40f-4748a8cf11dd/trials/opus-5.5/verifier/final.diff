+def _k_connected_parts(G, k):
+    """Returns the maximal sets of nodes of `G` inducing `k`-connected subgraphs.
+
+    `G` is a candidate `k`-component found by the heuristics. In most cases
+    it is `k`-connected, which the approximate node connectivity, a lower
+    bound of the actual node connectivity, is usually enough to confirm.
+    Otherwise the exact `k`-components of `G` are returned.
+    """
+    if approximate_node_connectivity(G) >= k or nx.node_connectivity(G) >= k:
+        return [set(G)]
+    return nx.k_components(G).get(k, [])
