+    S = []
+    P = {s: []}
+    sigma = {s: 1}
+    if weight is None:  # use BFS
+        D = {s: 0}
+        Q = deque([s])
+        while Q:
+            v = Q.popleft()
+            S.append(v)
+            dist = D[v] + 1
+            for w in G._adj[v]:
