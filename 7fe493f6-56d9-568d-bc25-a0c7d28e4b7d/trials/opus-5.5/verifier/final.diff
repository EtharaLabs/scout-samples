+class _DisconnectedGraphError(nx.NetworkXNoPath, nx.NetworkXError):
+    """Raised when a measure that needs a connected graph gets a disconnected one.
+
+    It is both a `NetworkXNoPath` (some distances are infinite) and a
+    `NetworkXError`, like the errors of the other distance measures.
+    """
+
+
+@not_implemented_for("directed")
+@nx._dispatchable(edge_attrs="weight")
+def centroid(G, *, weight=None):
+    r"""Returns the centroid of a connected undirected graph.
+
+    For two nodes $u$ and $v$ let $n(u, v)$ be the number of nodes that are
+    strictly closer to $u$ than to $v$. Placing a facility at $u$ while a
+    competitor places one at $v$, $n(u, v) - n(v, u)$ is the margin by which
+    $u$ wins the nodes over $v$. The *centroid* of `G` is the set of nodes $u$
+    with the largest worst-case margin [1]_ [2]_
+
+    .. math::
+
+        f(u) = \min_{v \neq u} \left( n(u, v) - n(v, u) \right).
+
+    For trees this is the classical centroid: the node or two adjacent nodes
+    whose removal leaves components of at most half of the nodes (see
+    :func:`~networkx.algorithms.tree.distance_measures.centroid`), which also
+    coincides with the barycenter of the tree.
+
+    Parameters
+    ----------
+    G : NetworkX graph
+        A connected undirected graph.
+
+    weight : string, function, or None, optional (default=None)
+        If None, every edge has length 1. Otherwise this is the edge attribute
+        (or function) giving the edge lengths used to measure distances, as in
+        :func:`~networkx.algorithms.shortest_paths.generic.shortest_path_length`.
+        Weights must be nonnegative.
+
+    Returns
+    -------
+    list
+        Nodes of `G` in the centroid, in the order of ``G.nodes``.
+
+    Raises
+    ------
+    NetworkXNotImplemented
+        If `G` is directed.
+    NetworkXPointlessConcept
+        If `G` has no nodes.
+    NetworkXNoPath
+        If `G` is disconnected (the exception is also a `NetworkXError`).
+
+    Notes
+    -----
+    The computation needs the distances between all pairs of nodes and
+    compares them for every pair of nodes, so it takes $O(n^3)$ time for a
+    graph with $n$ nodes. For unweighted trees the linear time algorithm of
+    :func:`~networkx.algorithms.tree.distance_measures.centroid` is used.
+
+    Examples
+    --------
+    >>> nx.centroid(nx.path_graph(4))
+    [1, 2]
+    >>> nx.centroid(nx.wheel_graph(6))
+    [0]
+    >>> nx.centroid(nx.cycle_graph(4))
+    [0, 1, 2, 3]
+
+    See Also
+    --------
+    barycenter
+    center
+    :func:`~networkx.algorithms.tree.distance_measures.centroid` : tree centroid
+
+    References
+    ----------
+    .. [1] P. J. Slater, "Maximin facility location",
+       Journal of Research of the National Bureau of Standards, 79B (1975),
+       pp. 107--115.
+    .. [2] C. Smart and P. J. Slater, "Center, median, and centroid subgraphs",
+       Networks, 34 (1999), pp. 303--311.
+    """
+    if len(G) == 0:
+        raise nx.NetworkXPointlessConcept("G has no nodes.")
+    if weight is None and nx.is_tree(G):
+        return nx.tree.centroid(G)
+    if not nx.is_connected(G):
+        raise _DisconnectedGraphError(
+            f"Input graph {G} is disconnected, so it has no centroid."
+        )
+
+    if weight is None:
+        dist = dict(nx.all_pairs_shortest_path_length(G))
+    else:
+        dist = dict(nx.all_pairs_dijkstra_path_length(G, weight=weight))
+    nodes = list(G)
+    rows = [[dist[u][x] for x in nodes] for u in nodes]
+    margins = [math.inf] * len(nodes)
+    for i, du in enumerate(rows):
+        for j in range(i + 1, len(rows)):
+            dv = rows[j]
+            # (nodes closer to nodes[i]) - (nodes closer to nodes[j])
+            margin = sum(map(operator.lt, du, dv)) - sum(map(operator.gt, du, dv))
+            if margin < margins[i]:
+                margins[i] = margin
+            if -margin < margins[j]:
+                margins[j] = -margin
+    best = max(margins)
+    return [u for u, margin in zip(nodes, margins) if margin == best]
+
+
