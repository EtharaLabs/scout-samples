+def _reachability_bitsets(G, topo_order):
+    """Return the strict reachability relation of a DAG as integer bitsets.
+
+    Node ``topo_order[i]`` is identified with bit ``i``. The returned list holds,
+    for each position ``i``, an integer whose set bits are the positions of the
+    nodes reachable from ``topo_order[i]`` by a non-empty path.
+    """
+    index = {v: i for i, v in enumerate(topo_order)}
+    succ = G._succ
+    reach = [0] * len(topo_order)
+    for i in range(len(topo_order) - 1, -1, -1):
+        bits = 0
+        for w in succ[topo_order[i]]:
+            j = index[w]
+            bits |= (1 << j) | reach[j]
+        reach[i] = bits
+    return reach
+
+
+def _iter_bits(bits):
+    """Yield the positions of the set bits of the nonnegative integer `bits`.
+
+    Positions are generated in increasing order.
+    """
+    while bits:
+        low = bits & -bits
+        yield low.bit_length() - 1
+        bits ^= low
+
+
+def _maximum_bipartite_matching_size(adj_bits):
+    """Size of a maximum matching of a bipartite graph via Hopcroft--Karp.
+
+    Both sides of the bipartite graph are ``range(n)`` with ``n = len(adj_bits)``
+    and the set bits of the integer ``adj_bits[u]`` are the right-side neighbors
+    of the left node ``u``. Neighbors are enumerated lazily and the search for
+    augmenting paths is iterative, so that dense relations and long augmenting
+    paths are handled without materializing every pair or exhausting the
+    recursion limit.
+    """
+    n = len(adj_bits)
+    unmatched = -1
+    match_left = [unmatched] * n
+    match_right = [unmatched] * n
+    size = 0
+    # Greedy initial matching: match each node with its first free neighbor.
+    free_right = (1 << n) - 1
+    for u, bits in enumerate(adj_bits):
+        candidates = bits & free_right
+        if candidates:
+            v = (candidates & -candidates).bit_length() - 1
+            match_left[u] = v
+            match_right[v] = u
+            free_right ^= 1 << v
+            size += 1
+
+    infinity = n + 1
+    while True:
+        # Breadth-first search building the layers of alternating paths.
+        # Every right node is scanned at most once per phase.
+        dist = [infinity] * n
+        queue = deque()
+        for u in range(n):
+            if match_left[u] == unmatched:
+                dist[u] = 0
+                queue.append(u)
+        unseen_right = (1 << n) - 1
+        found_free = False
+        while queue:
+            u = queue.popleft()
+            new_right = adj_bits[u] & unseen_right
+            unseen_right ^= new_right
+            for v in _iter_bits(new_right):
+                w = match_right[v]
+                if w == unmatched:
+                    found_free = True
+                elif dist[w] == infinity:
+                    dist[w] = dist[u] + 1
+                    queue.append(w)
+        if not found_free:
+            return size
+        # Depth-first search for augmenting paths along the layers.
+        nbr_iters = {}
+        for root in range(n):
+            if match_left[root] != unmatched:
+                continue
+            stack = [root]
+            via = []
+            if root not in nbr_iters:
+                nbr_iters[root] = _iter_bits(adj_bits[root])
+            while stack:
+                u = stack[-1]
+                for v in nbr_iters[u]:
+                    w = match_right[v]
+                    if w == unmatched:
+                        # augment along stack[0] - via[0] - stack[1] - ... - v
+                        via.append(v)
+                        for left, right in zip(stack, via):
+                            match_left[left] = right
+                            match_right[right] = left
+                        size += 1
+                        stack = []
+                        break
+                    if dist[w] == dist[u] + 1:
+                        via.append(v)
+                        stack.append(w)
+                        if w not in nbr_iters:
+                            nbr_iters[w] = _iter_bits(adj_bits[w])
+                        break
+                else:
+                    # dead end: no augmenting path continues through u
+                    dist[u] = infinity
+                    stack.pop()
+                    if via:
+                        via.pop()
+
