+                self._print(cond),
+                self._print(e),
+                0)
+
+        return '{}({}, {}, {})'.format(
+            self._module_format("torch.where"),
+            self._print(cond),
+            self._print(e),
+            self._print(Piecewise(*expr.args[1:])))
