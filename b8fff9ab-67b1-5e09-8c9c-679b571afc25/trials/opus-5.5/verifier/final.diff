+class DefinedFunction(Function):
+    """Base class for defined functions like ``sin``, ``cos``, ...
+
+    Explanation
+    ===========
+
+    :class:`Function` is used both to create undefined functions such as
+    ``f = Function('f')`` and as the base class of functions that are defined
+    explicitly, either by SymPy (``sin``, ``exp``, ``gamma``, ...) or by
+    subclassing. ``DefinedFunction`` is the base class for the latter kind:
+    calling it (or a subclass) always applies the function to its arguments
+    and returns an expression, never a new function class.
+
+    Examples
+    ========
+
+    >>> from sympy import sin, Function
+    >>> from sympy.core.function import DefinedFunction, AppliedUndef
+    >>> issubclass(sin, DefinedFunction)
+    True
+    >>> f = Function('f')
+    >>> isinstance(f(1), DefinedFunction), isinstance(f(1), AppliedUndef)
+    (False, True)
+
+    A new function can be defined by subclassing ``DefinedFunction``:
+
+    >>> class my_func(DefinedFunction):
+    ...     @classmethod
+    ...     def eval(cls, x):
+    ...         if x.is_Number:
+    ...             return x + 1
+    >>> my_func(2)
+    3
+
+    See Also
+    ========
+
+    Function, AppliedUndef
+    """
+
+    @cacheit
+    def __new__(cls, *args, **options):
+        return cls._new_(*args, **options)
