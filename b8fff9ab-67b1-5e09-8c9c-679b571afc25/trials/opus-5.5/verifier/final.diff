+# HermitianPredicate and AntihermitianPredicate
+#
+# The handlers in sets.py treat their argument as a scalar, so matrix
+# expressions need their own handlers based on the structure of the
+# expression: a matrix X is hermitian if adjoint(X) == X and antihermitian
+# if adjoint(X) == -X.
+
+def _matrix_herm_antiherm(expr, assumptions, predicate):
+    if isinstance(expr, MatrixBase):
+        # explicit matrices are handled by checking their elements
+        raise MDNotImplementedError
+    if ask(Q.square(expr), assumptions) is False:
+        return False
+    if predicate(expr) in conjuncts(assumptions):
+        return True
+    from sympy.functions.elementary.complexes import adjoint
+    adj = adjoint(expr)
+    if predicate is Q.hermitian:
+        if adj == expr:
+            return True
+    elif adj == -expr:
+        return True
+    return None
