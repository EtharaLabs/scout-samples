+                names.setdefault(c, set()).add(b)
+    syms = {c: b.pop() for c, b in names.items()
+            if len(b) == 1 and not isinstance(next(iter(b)), Wild)}
+    if syms:
+        value = value.xreplace(syms)
+    return value
