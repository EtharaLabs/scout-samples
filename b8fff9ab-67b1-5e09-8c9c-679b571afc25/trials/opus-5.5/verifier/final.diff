+    if not mat.is_square:
+        return False
+    ret_val = True
+    rows, cols = mat.shape
+    for i in range(rows):
+        for j in range(i, cols):
+            cond = fuzzy_bool(Eq(mat[i, j], -conjugate(mat[j, i])))
+            if cond is None:
