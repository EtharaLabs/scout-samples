+def _find_factor(N, smooth_relations, col, *args):
+    """ Finds proper factors of N using fast gaussian reduction for modulo 2
+    matrix.
+
+    The factorization vectors of the smooth relations (bit ``i`` of the
+    integer ``vec`` is the entry of column ``i``) are reduced so that each
+    linearly dependent combination of rows gives a relation of the form
+    ``X**2 = Y**2 modN``, and then a proper factor of N can be obtained by
+    ``gcd(X - Y, N)``.
+
+    Parameters
+    ==========
+
+    N : Number to be factored
+    smooth_relations : Smooth relations, a list of tuples ``(u, v, vec)``
+    col : Number of columns in the matrix (``len(factor_base) + 1``)
+
+    Yields
+    ======
+
+    Proper factors of N (not necessarily prime and possibly repeated).
+
+    Reference
+    ==========
+
+    .. [1] A fast algorithm for gaussian elimination over GF(2) and
+    its implementation on the GAPP. Cetin K.Koc, Sarath N.Arachchige
+    """
+    if args:
+        # old signature:
+        # _find_factor(dependent_rows, mark, gauss_matrix, index, smooth_relations, N)
+        return _find_factor_old(N, smooth_relations, col, *args)
+    return _find_factor_iter(N, smooth_relations, col)
+
+
+def _find_factor_iter(N, smooth_relations, col):
+    matrix = [s_relation[2] for s_relation in smooth_relations]
+    row = len(matrix)
+    mark = [False] * row
+    for pos in range(col):
+        m = 1 << pos
+        for i in range(row):
+            if matrix[i] & m:
+                break
+        else:
+            # no row has a 1 in this column
+            continue
+        mark[i] = True
+        add_col = matrix[i] ^ m
+        if add_col:
+            # add this column to all the other columns that have a 1
+            # in the pivot row
+            for j in range(row):
+                if matrix[j] & m:
+                    matrix[j] ^= add_col
+    # Now each marked row has a single 1 (in its own column) and every
+    # other row is a combination of marked rows.
+    for m, mat, rel in zip(mark, matrix, smooth_relations):
+        if m:
+            continue
+        u, v = rel[0], rel[1]
+        for m1, mat1, rel1 in zip(mark, matrix, smooth_relations):
+            if m1 and mat & mat1:
+                u *= rel1[0]
+                v *= rel1[1]
+        # assert is_square(v)
+        v = isqrt(v)
+        g = gcd(u - v, N)
+        if 1 < g < N:
+            yield g
