+def _undo_canonical(value, expr, pattern, canonical):
+    """Helper for ``Basic.match``: replace in ``value`` the canonical forms
+    of the subexpressions of ``expr`` having bound symbols by the
+    subexpressions themselves and the canonical symbols of the bound
+    symbols of ``pattern`` by those bound symbols."""
+    from .symbol import Wild
+    from .traversal import preorder_traversal
+    subs = {}
+    for e in preorder_traversal(expr):
+        if getattr(e, 'bound_symbols', None):
+            subs.setdefault(canonical(e), e)
+    if subs:
